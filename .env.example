# --- LLM backend: "groq" (cloud free tier) or "ollama" (local, free) ---
LLM_BACKEND=groq
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- SambaNova Cloud ---
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_MODEL=gemma-4-31B-it

# --- BigModel (DeepSeek) ---
BIGMODEL_API_KEY=your_bigmodel_api_key_here
BIGMODEL_MODEL=deepseek-v4.1-flash

# --- TypeSafe AI (Jev System One Decision Engine) ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest


# --- Tavily Web Search ---
TAVILY_API_KEY=your_tavily_api_key_here
ENABLE_TAVILY=true

# --- Embeddings (Ollama, local) ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_TOP_K=5

# --- Storage ---
CHROMA_PATH=./data/chroma
DOCUMENTS_PATH=./data/documents
MEMORY_DB_PATH=./data/memory.db
MEMORY_MAX_TURNS=10
MAX_UPLOAD_MB=25

# --- Supabase PostgreSQL Database ---
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.xybusfywybuxejnohkcd.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xybusfywybuxejnohkcd.supabase.co:5432/postgres
POSTGRES_HOST=db.xybusfywybuxejnohkcd.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here

# --- Server ---
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_MESSAGE_CONTENT=false
